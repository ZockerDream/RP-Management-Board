# Impressum – Kopieren: cp .env-impressum.example .env-impressum
# Leere Felder werden nicht angezeigt. Danach: docker compose up -d api
IMPRINT_NAME=Max Mustermann
IMPRINT_REPRESENTATIVE=
IMPRINT_STREET=Musterstraße 1
IMPRINT_POSTAL_CODE=12345
IMPRINT_CITY=Musterstadt
IMPRINT_COUNTRY=Deutschland
IMPRINT_EMAIL=kontakt@example.com
IMPRINT_PHONE=
IMPRINT_WEBSITE=
# z. B. Handelsregister HRB 12345, Amtsgericht Musterstadt
IMPRINT_REGISTER=
IMPRINT_VAT_ID=
# Verantwortlich für den Inhalt nach § 18 Abs. 2 MStV
IMPRINT_RESPONSIBLE=
# Zuständige Aufsichtsbehörde (falls erforderlich)
IMPRINT_SUPERVISORY=
# Freitext, z. B. Hinweis zur Verbraucherstreitbeilegung
IMPRINT_NOTE=
