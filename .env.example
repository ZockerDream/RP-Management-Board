# RP-Management-Board – Konfiguration. Kopieren: cp .env.example .env
# Secrets erzeugen: ./scripts/gen-secrets.sh  (füllt leere Werte automatisch)

# ---- Zugriff ----------------------------------------------------------------
# Öffentliche Adresse ohne Slash am Ende. Wird für Cookies, Links in Mails usw. genutzt.
# Ohne eigenen TLS-Proxy z. B. http://<server-ip>:8080 verwenden.
APP_URL=http://localhost:8080
# Einziger veröffentlichter App-Port; ein eigener TLS-Proxy ist optional.
# BIND_ADDR=127.0.0.1, wenn nur ein Proxy auf demselben Host zugreifen soll.
BIND_ADDR=0.0.0.0
HTTP_PORT=8080
# Standardmäßig werden keine X-Forwarded-* Header vertraut. Optional IPs/CIDRs kommasepariert.
TRUST_PROXY=false
TZ=Europe/Berlin

# ---- Datenbank (nur Buchstaben/Ziffern im Passwort, kein Sonderzeichen) ------
# Gelten nur beim allerersten Start (leeres Volume). Spätere Änderungen übernimmt PostgreSQL nicht,
# die App startet dann mit „Die Datenbank lehnt die Anmeldung ab“ (siehe README).
DB_NAME=budget
DB_USER=budget
DB_PASSWORD=

# ---- Secrets (je mindestens 32 Zeichen, zufällig) -----------------------------
# JWT_SECRET signiert Zugriffstoken, ENCRYPTION_KEY verschlüsselt 2FA-Secrets, Webhook-Secrets und Backups.
# ENCRYPTION_KEY NIEMALS verlieren oder ändern – sonst sind 2FA und verschlüsselte Backups unbrauchbar.
JWT_SECRET=
ENCRYPTION_KEY=

# ---- Initialer Administrator (wird nur beim ersten Start angelegt) -----------
# Passwort: min. 10 Zeichen, 3 von 4 Zeichenklassen. Nach dem ersten Login ändern und die Variable leeren.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# ---- Sicherheit ---------------------------------------------------------------
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=14
# Selbstregistrierung (kann zusätzlich im Admin-Bereich umgeschaltet werden)
ALLOW_REGISTRATION=false
# Passwörter gegen Have I Been Pwned prüfen (k-Anonymity, sendet nur 5 Hash-Zeichen; benötigt Internet)
HIBP_CHECK=false

# ---- E-Mail (optional; ohne SMTP werden Einladungs-/Reset-Links nicht verschickt) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="RP-Management-Board <noreply@example.com>"

# ---- Betrieb ------------------------------------------------------------------
BACKUP_ENCRYPT=true
BACKUP_RETENTION_DAYS=14
BACKUP_HOUR=3
MAX_UPLOAD_MB=10
HOLIDAY_COUNTRY=DE
# z. B. BY, NW, BE …
HOLIDAY_REGION=
LOG_LEVEL=info
# Kein APP_VERSION mehr nötig: Das Image heißt nach der Code-Version (docker-compose.yml).
# Nur Test-Stacks setzen IMAGE_TAG, damit sie das Image der Instanz nicht überschreiben.

# ---- Google / Microsoft Kontakte & Kalender (optional) ------------------------
# OAuth redirect URIs: APP_URL/api/integrations/google/callback
# and APP_URL/api/integrations/microsoft/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# ---- Musik (optional) ---------------------------------------------------------
# Ordner mit Musikdateien (mp3, m4a, aac, ogg, opus, flac, wav, webm) auf dem Host; Unterordner erscheinen als Alben.
# Wird nur lesend eingebunden. Ohne Angabe: ./music neben docker-compose.yml.
MUSIC_DIR=./music
# Größte hochladbare Musikdatei in MB (Musik → Vom Server → Hochladen; Ablage im Upload-Volume)
MUSIC_UPLOAD_MB=50
# Spotify: Jeder meldet sich selbst mit seinem Konto an (PKCE, kein Secret). Die Client-ID der Spotify-App trägt ein Admin
# am einfachsten unter Server-Management → Integrationen ein; diese Variable ist nur die Vorgabe dafür.
# App unter https://developer.spotify.com/dashboard anlegen (Web API), Redirect URI: APP_URL/api/music/spotify/callback
# (Spotify verlangt HTTPS, außer für http://127.0.0.1). Steuern geht nur mit Spotify Premium.
SPOTIFY_CLIENT_ID=

# ---- Fehlerberichte via GitHub (optional) -------------------------------------
GITHUB_ISSUES_TOKEN=
GITHUB_ISSUES_REPOSITORY=ZockerDream/RP-Management-Board

# Impressum: eigene Datei .env-impressum (Vorlage: .env-impressum.example)
