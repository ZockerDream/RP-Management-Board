# Budget Manager – Konfiguration. Kopieren: cp .env.example .env
# Secrets erzeugen: ./scripts/gen-secrets.sh  (füllt leere Werte automatisch)

# ---- Zugriff ----------------------------------------------------------------
# Öffentliche Adresse ohne Slash am Ende. Wird für Cookies, Links in Mails usw. genutzt.
# Ohne eigenen TLS-Proxy z. B. http://<server-ip>:8080 verwenden.
APP_URL=http://localhost:8080
# Einziger veröffentlichter App-Port; ein eigener TLS-Proxy ist optional.
# BIND_ADDR=127.0.0.1, wenn nur ein Proxy auf demselben Host zugreifen soll.
BIND_ADDR=0.0.0.0
HTTP_PORT=8080
# Standardmäßig werden keine X-Forwarded-* Header vertraut. Optional IPs/CIDRs kommasepariert.
TRUST_PROXY=false
TZ=Europe/Berlin

# ---- Datenbank (nur Buchstaben/Ziffern im Passwort, kein Sonderzeichen) ------
DB_NAME=budget
DB_USER=budget
DB_PASSWORD=

# ---- Secrets (je mindestens 32 Zeichen, zufällig) -----------------------------
# JWT_SECRET signiert Zugriffstoken, ENCRYPTION_KEY verschlüsselt 2FA-Secrets, Webhook-Secrets und Backups.
# ENCRYPTION_KEY NIEMALS verlieren oder ändern – sonst sind 2FA und verschlüsselte Backups unbrauchbar.
JWT_SECRET=
ENCRYPTION_KEY=

# ---- Initialer Administrator (wird nur beim ersten Start angelegt) -----------
# Passwort: min. 10 Zeichen, 3 von 4 Zeichenklassen. Nach dem ersten Login ändern und die Variable leeren.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# ---- Sicherheit ---------------------------------------------------------------
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=14
# Selbstregistrierung (kann zusätzlich im Admin-Bereich umgeschaltet werden)
ALLOW_REGISTRATION=false
# Passwörter gegen Have I Been Pwned prüfen (k-Anonymity, sendet nur 5 Hash-Zeichen; benötigt Internet)
HIBP_CHECK=false

# ---- E-Mail (optional; ohne SMTP werden Einladungs-/Reset-Links nicht verschickt) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Budget Manager <noreply@example.com>"

# ---- Betrieb ------------------------------------------------------------------
BACKUP_ENCRYPT=true
BACKUP_RETENTION_DAYS=14
BACKUP_HOUR=3
MAX_UPLOAD_MB=10
HOLIDAY_COUNTRY=DE
# z. B. BY, NW, BE …
HOLIDAY_REGION=
LOG_LEVEL=info
APP_VERSION=1.0.0
